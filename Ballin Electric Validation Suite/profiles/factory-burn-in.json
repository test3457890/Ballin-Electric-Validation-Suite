{
  "schema": 1,
  "id": "factory-burn-in",
  "version": "0.1.0",
  "name": "Factory Burn-In (BE-01 DRAFT)",
  "description": "DRAFT factory acceptance sequence for BE-01. Thresholds, durations and manifest values are proposals pending engineering approval. Requires authorization and an approved safety profile.",
  "planned_minutes": [480, 1440],
  "allow_warnings": false,
  "release_profile": true,
  "steps": [
    { "test": "BE-T-INV-001", "key": "manifest", "timeout_s": 60, "params": { "manifest": { "name": "BE-01 DRAFT", "gpu_count": 2, "min_storage_devices": 1, "min_network_speed_mbps": 10000 } } },
    { "test": "BE-T-SNS-001", "key": "preflight-sensors", "timeout_s": 60, "requires": ["manifest"] },
    { "test": "BE-T-FW-001", "timeout_s": 60, "params": { "require_secure_boot": false, "require_tpm": true } },
    { "test": "BE-T-OS-001", "key": "log-before", "timeout_s": 120 },
    { "test": "BE-T-STO-002", "timeout_s": 120 },
    { "test": "BE-T-PCIE-001", "timeout_s": 60 },
    { "test": "BE-T-NET-001", "timeout_s": 60, "params": { "expected_mbps": 10000 } },
    { "test": "BE-T-GPU-001", "timeout_s": 120, "params": { "expected_count": 2 } },
    { "test": "BE-T-CPU-001", "timeout_s": 900 },
    { "test": "BE-T-MEM-001", "timeout_s": 3600, "params": { "size_mib": 4096, "passes": 2 } },
    { "test": "BE-T-STO-001", "timeout_s": 3600, "params": { "size_mib": 4096 } },
    { "test": "BE-T-GPU-002", "timeout_s": 3600, "requires": ["BE-T-GPU-001"] },
    { "test": "BE-T-GPU-003", "timeout_s": 3600, "requires": ["BE-T-GPU-001"] },
    { "test": "BE-T-CPU-STRESS", "timeout_s": 15000, "params": { "duration_s": 14400 }, "requires": ["preflight-sensors", "BE-T-CPU-001"] },
    { "test": "BE-T-MEM-STRESS", "timeout_s": 15000, "params": { "size_mib": 16384, "passes": 8 }, "requires": ["preflight-sensors", "BE-T-MEM-001"] },
    { "test": "BE-T-GPU-004", "timeout_s": 15000, "requires": ["BE-T-GPU-002", "BE-T-GPU-003"] },
    { "test": "BE-T-SYS-001", "timeout_s": 15000, "params": { "duration_s": 14400, "memory_mib": 8192 }, "requires": ["BE-T-CPU-STRESS", "BE-T-MEM-STRESS", "BE-T-GPU-004"] },
    { "test": "BE-T-SNS-001", "key": "cooldown-sensors", "timeout_s": 60, "requires": ["BE-T-SYS-001"] },
    { "test": "BE-T-OS-001", "key": "log-after", "timeout_s": 120 }
  ],
  "manual_checks": [
    { "id": "chassis-finish", "label": "Chassis finish free of scratches, dents and contamination" },
    { "id": "fasteners", "label": "All assembly fasteners present and torqued" },
    { "id": "gpu-retention", "label": "GPU retention brackets installed and secure" },
    { "id": "wiring", "label": "Wiring routed; power and data connectors fully seated" },
    { "id": "ventilation", "label": "Intake and exhaust ventilation unobstructed" },
    { "id": "hinges", "label": "Display hinges operate smoothly and hold position" },
    { "id": "kickstand", "label": "Kickstand stable on reference surface" },
    { "id": "screens", "label": "Both displays: no visible pixel defects, cracks or pressure marks (operator inspection)" },
    { "id": "ports", "label": "External ports checked with known test devices" },
    { "id": "accessories", "label": "Accessories complete per BOM" },
    { "id": "packaging", "label": "Packaging intact and labelled" },
    { "id": "electrical-safety", "label": "Electrical safety (hipot/ground bond) recorded from approved external procedure", "instrument": true }
  ]
}
