{
  "schema": 1,
  "id": "extended-stability",
  "version": "1.0.0",
  "name": "Extended Stability",
  "description": "Isolated and combined error-aware high-load tests. Requires operator authorization and an APPROVED hardware safety profile. Planning durations only; not validated production limits.",
  "planned_minutes": [120, 240],
  "allow_warnings": false,
  "steps": [
    { "test": "BE-T-INV-001", "timeout_s": 60 },
    { "test": "BE-T-SNS-001", "timeout_s": 60 },
    { "test": "BE-T-CPU-001", "timeout_s": 900 },
    { "test": "BE-T-MEM-001", "timeout_s": 1800, "params": { "size_mib": 1024 } },
    { "test": "BE-T-CPU-STRESS", "timeout_s": 4200, "params": { "duration_s": 3600 }, "requires": ["BE-T-SNS-001", "BE-T-CPU-001"] },
    { "test": "BE-T-MEM-STRESS", "timeout_s": 7200, "params": { "size_mib": 8192, "passes": 4 }, "requires": ["BE-T-SNS-001", "BE-T-MEM-001"] },
    { "test": "BE-T-SYS-001", "timeout_s": 2400, "params": { "duration_s": 1800, "memory_mib": 2048 }, "requires": ["BE-T-CPU-STRESS", "BE-T-MEM-STRESS"] },
    { "test": "BE-T-SNS-001", "key": "cooldown-sensors", "timeout_s": 60, "requires": ["BE-T-SYS-001"] }
  ],
  "manual_checks": []
}
